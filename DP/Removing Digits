import java.util.*;
public class HelloWorld {
    public static void main(String[] args) {
         Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        int[] dp = new int[n + 1];
        Arrays.fill(dp,Integer.MAX_VALUE);

        dp[0] = 0; // base case

        for (int i = 1; i <= n; i++) {
            int temp = i;
            while (temp > 0) {
                int digit = temp % 10; //remove last digit
                temp /= 10;  //bacha hua sub ke bad

                if (digit > 0) {
                    dp[i] = Math.min(dp[i], dp[i - digit] + 1);
                }
            }
        }

        System.out.println(dp[n]);
    }
      
}
     



