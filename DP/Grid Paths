import java.util.*;
public class HelloWorld {
   static final int MOD = 1_000_000_007;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        char[][] grid = new char[n][n];
        for (int i = 0; i < n; i++) {
            grid[i] = sc.next().toCharArray();
        }

        long[][] dp = new long[n][n];

        if (grid[0][0] == '*') {              //If starting cell has a trap → no paths possible
            System.out.println(0);
            return;
        }
        dp[0][0] = 1;    //There is 1 way to stand at the starting cell (if it’s not a trap)

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] == '*') {
                    dp[i][j] = 0;
                } else {
                    if (i > 0)
                        dp[i][j] = (dp[i][j] + dp[i - 1][j]) % MOD;     //Top cell → (i-1, j) (down move)
                    if (j > 0)
                        dp[i][j] = (dp[i][j] + dp[i][j - 1]) % MOD;     //Left cell → (i, j-1) (right move)
                }
            }
        }

        System.out.println(dp[n - 1][n - 1]);
    }   
}
     



