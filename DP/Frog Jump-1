import java.util.*;
public class HelloWorld { 
       public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
          int N = sc.nextInt();
          int[] h = new int[N];
          for (int i = 0; i < N; i++) {
            h[i] = sc.nextInt();
        }
        
        int[] dp = new int[N];
        dp[0] = 0;          //base case
    
        for(int i = 1; i < N; i++){
          int one_jump = dp[i - 1] + Math.abs(h[i] - h[ i - 1]);
          int two_jump = Integer.MAX_VALUE;
          if(i > 1){
            two_jump = dp[i - 2] + Math.abs(h[i] - h[i - 2]);
          }
          dp[i] = Math.min(one_jump,two_jump);
        }
        System.out.println(dp[N -1]);
       }
}



